{
  "name": "visualtalk",
  "version": "0.1.36",
  "description": "Video conferencing application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:debug": "tauri build --debug",
    "dev:pro": "VITE_ENABLE_E2EE=true vite",
    "build:pro": "VITE_ENABLE_E2EE=true vite build",
    "desktop:pro": "VITE_ENABLE_E2EE=true tauri dev",
    "desktop:build:pro": "VITE_ENABLE_E2EE=true tauri build",
    "mac:init": "tauri macos init",
    "mac:build": "tauri build --target aarch64-apple-darwin",
    "mac:build:intel": "tauri build --target x86_64-apple-darwin",
    "mac:build:universal": "tauri build --target universal-apple-darwin",
    "win:build": "tauri build --target x86_64-pc-windows-msvc",
    "win:build:arm": "tauri build --target aarch64-pc-windows-msvc",
    "linux:build": "tauri build --target x86_64-unknown-linux-gnu",
    "linux:build:arm": "tauri build --target aarch64-unknown-linux-gnu",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:dev:pro": "VITE_ENABLE_E2EE=true tauri android dev",
    "android:build": "tauri android build --apk",
    "android:build:pro": "VITE_ENABLE_E2EE=true tauri android build --apk",
    "android:build:aab": "tauri android build --aab",
    "android:build:aab:pro": "VITE_ENABLE_E2EE=true tauri android build --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:dev:pro": "VITE_ENABLE_E2EE=true tauri ios dev",
    "ios:dev:device": "tauri ios dev --force-ip-prompt",
    "ios:dev:device:pro": "VITE_ENABLE_E2EE=true tauri ios dev --force-ip-prompt",
    "ios:open": "tauri ios build --open",
    "ios:build": "tauri ios build --export-method debugging",
    "ios:build:pro": "VITE_ENABLE_E2EE=true tauri ios build --export-method debugging",
    "ios:build:release": "tauri ios build --export-method release-testing",
    "ios:build:release:pro": "VITE_ENABLE_E2EE=true tauri ios build --export-method release-testing",
    "ios:build:store": "tauri ios build --export-method app-store-connect",
    "ios:build:store:pro": "VITE_ENABLE_E2EE=true tauri ios build --export-method app-store-connect",
    "android:clean": "rm -rf src-tauri/gen/android",
    "ios:clean": "rm -rf src-tauri/gen/apple",
    "mobile:init": "pnpm ios:init && pnpm android:init",
    "clean:all": "pnpm ios:clean && pnpm android:clean"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "livekit-client": "^2.22.3",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  }
}