# Local LiveKit stack for VisualTalk.
#
#   cp docker/.env.example docker/.env     # then edit, or let the helper script
#                                          # generate a random key pair for you:
#   python3 scripts/livekit-local.py up
#
# docker/.env is git-ignored - it holds credentials. Never commit it.

# ── LiveKit API credentials ──────────────────────────────────────────────────
# These are the ONLY credentials the local server accepts. Paste the same pair
# into VisualTalk: Settings -> LiveKit -> API key / API secret.
#
# Rules enforced by livekit-server:
#   * the secret must be at least 32 characters (it logs an error otherwise);
#   * neither value may contain ':' or '#' - they are parsed as YAML "key: secret";
#   * the values below are placeholders: replace them before exposing the server
#     beyond 127.0.0.1 (LIVEKIT_BIND_ADDR).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec

# ── Images ───────────────────────────────────────────────────────────────────
# Pinned: a floating tag (v1.13) would silently change the server under you.
LIVEKIT_VERSION=v1.13.10
EGRESS_VERSION=v1.15.0
REDIS_VERSION=7-alpine

# ── Networking ───────────────────────────────────────────────────────────────
# Host address the published ports bind to:
#   127.0.0.1 = this machine only (default; recommended)
#   0.0.0.0   = also reachable from your LAN - then LIVEKIT_NODE_IP below MUST
#               be this machine's LAN address, not 127.0.0.1
LIVEKIT_BIND_ADDR=127.0.0.1

# IP advertised to clients as a WebRTC ICE candidate. It has to be reachable
# *from the client*, which is not necessarily this machine's own view of itself:
#   loopback use (app on this machine)  -> 127.0.0.1
#   phones/tablets on the same Wi-Fi    -> your LAN IP
#                                          (macOS: ipconfig getifaddr en0,
#                                           Linux: hostname -I | awk '{print $1}')
# Leaving it empty lets livekit-server auto-detect an interface, which on a
# laptop with VPN/Docker adapters frequently picks the wrong one.
LIVEKIT_NODE_IP=127.0.0.1

# 7880 HTTP API + WebSocket signalling, 7881 ICE/TCP fallback, 7882 ICE/UDP.
# The URL you type into VisualTalk is ws://127.0.0.1:7880 (or ws://<LAN IP>:7880).
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
# Single muxed UDP port, because Docker bridge networking cannot publish the
# 50000-60000 range. Must match the value the container listens on.
LIVEKIT_UDP_PORT=7882

LIVEKIT_LOG_LEVEL=info

# ── Recording (egress service) ───────────────────────────────────────────────
# Host directory mounted at /recordings inside the egress container. VisualTalk
# asks egress for /recordings/<room>-<timestamp>.mp4 by default, so finished
# recordings appear here. Relative paths resolve against docker/.
#
# On Linux the egress container runs as uid 1001: the directory must be writable
# by it (chown -R 1001 <dir>, or let scripts/livekit-local.py create it).
# Never delete this directory while the stack is up - the container keeps the
# old inode and every recording then fails with
# "Local upload failed: ... no such file or directory". Restart egress if you do.
LIVEKIT_RECORDINGS_DIR=./recordings

# ── Live Translation (Whisper service) ───────────────────────────────────────
# Local Whisper speech-to-text for live captions (Pro Edition, self-hosted /
# direct distributions only - see docs/decisions/0003-translation-architecture.md).
#   start it with:  python3 scripts/livekit-local.py up --translation
# Routes, request/response contract and measured latency:
#   docs/whisper-service-contract.md
# NOTE: the service translates into ENGLISH only - it cannot produce captions in
# an arbitrary target language (see that document, section 5).
WHISPER_BIND_ADDR=127.0.0.1
# Loopback only, deliberately: the service has NO authentication, so a
# LAN-reachable port lets anyone on the network transcribe audio and load models.
WHISPER_PORT=8080
# Pinned because upstream is ARCHIVED (the project moved to speaches-ai/speaches);
# latest-cpu and 0.5.0-cpu are the same image today. CPU build, ~1.68 GB unpacked.
WHISPER_VERSION=0.5.0-cpu
# Model, in the image's OWN spelling (double underscore) and as a full Hugging
# Face repo id - a bare size name like "small" is invalid and makes every request
# fail with an opaque 500. Lighter/faster alternative:
#   WHISPER__MODEL=Systran/faster-whisper-tiny
# Unset means Systran/faster-whisper-small (the image default).
WHISPER__MODEL=Systran/faster-whisper-small
