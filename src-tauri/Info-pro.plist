<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>VisualTalk Pro needs access to your camera for video calls.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>VisualTalk Pro needs access to your microphone for audio communication.</string>
    <key>NSContactsUsageDescription</key>
    <string>VisualTalk Pro accesses contacts only when you choose contacts to invite to a meeting.</string>

    <!-- Invite links: `visualtalk://join?…` opens the app instead of forcing the
         guest to copy-paste (ADR 0007). Kept key-for-key in sync with
         Info.plist except for the bundle-identifier-derived URL name below;
         tauri.conf.json (plugins.deep-link) covers Windows/Linux and
         scripts/fix-android-project.py adds the Android intent-filter. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.katebg.visualtalk.pro.invite</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>visualtalk</string>
            </array>
        </dict>
    </array>

    <!-- PRO VARIANT of Info.plist, pointed at by src-tauri/tauri.pro.conf.json
         (bundle.macOS.infoPlist / bundle.iOS.infoPlist); the community edition
         keeps using Info.plist. Keep the two files key-for-key in sync except
         for the intentional differences: CFBundleDisplayName and the export
         compliance declaration below. -->

    <key>CFBundleDisplayName</key>
    <string>VisualTalk Pro</string>

    <!-- iOS only; inert on macOS. Keeps the meeting audio session alive when
         the app is backgrounded or the screen locks. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <key>NSLocalNetworkUsageDescription</key>
    <string>VisualTalk Pro connects to an AI service on your local network to power live captions and summaries.</string>

    <!-- EXPORT COMPLIANCE — PRO DECLARES YES (conservative).
         On top of the community edition's transport crypto (TLS, DTLS-SRTP),
         Pro adds AES-256-GCM end-to-end encryption of chat and file transfers
         (ECDH P-256 key agreement, HKDF-SHA-256 KDF): confidentiality of user
         content, not merely transport protection. All primitives are standard
         published algorithms (NIST/IETF) from public RustCrypto crates — no
         proprietary crypto — so mass-market/exempt treatment under the Note
         to Category 5 Part 2 (5D992-type) is the expected classification.
         But YES is declared until counsel confirms that classification AND
         the one-time BIS self-classification report is filed (owner decision
         2026-10-19). Flip path and ASC questionnaire answers:
         docs/export-compliance-pro.md §6 (French: .fr.md).
         The community edition's Info.plist keeps <false/> with its own
         reasoning; do not "sync" this key between the two files. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <true/>

    <!-- iOS only; inert on macOS. Exposes Documents in the Files app. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
</dict>
</plist>
