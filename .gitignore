# NOTE: tauri.conf.json / package.json / vite.config.js / .gitignore must NOT
# be ignored here, even as a "just in case" safeguard. They are tracked, so git
# ignores the patterns — but gitignore-aware tooling (globby with gitignore:
# true, which tauri-action@v1 uses to locate src-tauri/tauri.conf.json) filters
# purely by pattern and fails with "Couldn't detect Tauri dir".

# ── Compliance / legal files must ALWAYS be tracked ───────────────────────────
# The blanket *.md / *.txt / *.lock rules above would silently drop these.
# Keep the negations below in sync with anything added for store submission or
# license compliance (verified with: git check-ignore -v <path>).
!README.md
!THIRD_PARTY_NOTICES.md
!CONTRIBUTING.md
!SECURITY.md
!PRIVACY.md
!CODE_OF_CONDUCT.md
!CHANGELOG.md
!SUPPORT.md
!LICENSE
!NOTICE
!NOTICE.txt
!docs/**/*.md

# Agent workflow is part of the repo: keep AGENTS.md, Guidance.md, and the
# .opencode markdown files in a fresh clone. The blanket *.md rule above would
# otherwise drop them silently. Verified with: git check-ignore -v <path>.
!AGENTS.md
!Guidance.md
!.opencode/**/*.md

# PII-dense filing drafts (owner's private store, NOT for public repo).
# Placed AFTER the !docs/**/*.md whitelist above — last match wins.
docs/anssi-*
# BIS self-classification drafts (PII-dense, on HOLD — see docs/bis-self-classification-email.md).
docs/bis-*
!src-tauri/Cargo.lock
!pnpm-lock.yaml
# Local LiveKit stack: the template must be tracked, the real .env must not.
!docker/.env.example

# ── Python tooling (scripts/generate-notices.py) ────────────────────────────────
__pycache__/
*.pyc

# Review-build demo credentials: written by scripts/make-review-build.py,
# sourced by the iOS "Build Rust Code" phase, removed when the script exits.
.review-creds.sh

# Local LiveKit egress output (docker/.env: LIVEKIT_RECORDINGS_DIR).
docker/recordings/

# Cloudflare upload staging (scripts/deploy-cloudflare.py stage): copies of the
# built installers plus generated SHA256SUMS.txt / latest.json.
dist-cloudflare/

# Per-release server-stack bundle (scripts/package-server-stack.py); lives on
# the GitHub Release, not in git.
product-release/visualtalk-server-*.zip

# Play Store marketing assets (screenshots, feature graphic): local-only,
# regenerated per release; not source.
product-release/play/

# Owner's Play working folder (policy copy + HTML render): local-only. The
# hosted policy at visualtalk.app/privacy is rendered from the canonical
# PRIVACY.md at deploy time, so a second copy here can only drift.
Google Play/

# Play tester email list: starts as one address and grows to ~20 personal
# addresses for the closed-testing gate. Upload it through the Console; a list
# of people's emails must never sit in a public repository.
tester-list.csv
